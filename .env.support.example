# RA Support Command Centre: server-side configuration.
# These are Supabase Edge Function secrets, NOT browser variables.
# Set with:  supabase secrets set --env-file <your private copy>
# Never commit real values. PArAsYtE | RA-Workspace support module

# --- Twilio account (auth token stays server-side only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Standard API key used to sign browser access tokens
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TwiML App for the softphone (created by scripts/provision-twilio-support.mjs)
TWILIO_TWIML_APP_SID=
# Verified Twilio number, or the Nigerian number on your BYOC trunk, in E.164
TWILIO_CALLER_ID=
# BYOC trunk SID (BYxxxxxxxx) if outbound goes over your own Nigerian SIP carrier
TWILIO_BYOC_TRUNK_SID=

# --- TaskRouter (all created by scripts/provision-twilio-support.mjs)
TWILIO_TASKROUTER_WORKSPACE_SID=
TWILIO_TASKROUTER_WORKFLOW_SID=
TWILIO_TASKROUTER_AVAILABLE_ACTIVITY_SID=
TWILIO_TASKROUTER_BUSY_ACTIVITY_SID=
TWILIO_TASKROUTER_WRAPUP_ACTIVITY_SID=
TWILIO_TASKROUTER_BREAK_ACTIVITY_SID=
TWILIO_TASKROUTER_OFFLINE_ACTIVITY_SID=

# --- Webhook URL used for signature checks
# Leave empty to use SUPABASE_URL/functions/v1. Set it only if Twilio reaches
# the functions through a custom domain, and use exactly what Twilio is configured with.
TWILIO_WEBHOOK_BASE_URL=

# --- Other secrets (generate each with: openssl rand -hex 32)
# Header x-support-cron-secret for support-maintenance
SUPPORT_CRON_SECRET=
# HMAC key for support-ingest (email relay, web chat widget, forms)
SUPPORT_INGEST_SECRET=
# HMAC key for support-sos-ingest (SOS events and identity codes from the RideArrivo backend). Keep it separate.
SUPPORT_SOS_SECRET=

# --- Live location (read by support-location). Leave empty until the RideArrivo location service is ready;
# the screen then says "not connected" instead of guessing.
RA_LOCATION_API_URL=
RA_LOCATION_API_KEY=

# --- Optional
# Extra browser origins allowed to call the functions, comma separated
SUPPORT_ALLOWED_ORIGINS=
# MP3 played to callers on hold; if empty they hear the hold message and silence
SUPPORT_HOLD_MUSIC_URL=

# Browser build only (Vite): preferred Twilio edges for the softphone, in order.
# VITE_TWILIO_EDGES=frankfurt,dublin,ashburn

# --- Staff invites (support-invite). Optional: without these the admin screen still shows the one-time code to hand over.
# Email via Resend (verify your sending domain in Resend first)
RESEND_API_KEY=
SUPPORT_INVITE_FROM_EMAIL=RideArrivo Support <support@ridearrivo.com>
SUPPORT_INVITE_REPLY_TO=
# Where the join page lives, e.g. https://intranet.ridearrivo.com/support-join.html
SUPPORT_JOIN_URL=
# WhatsApp invites: your approved WhatsApp sender and an approved template with variables {1} first name, {2} code, {3} join link
SUPPORT_INVITE_WA_FROM=
SUPPORT_INVITE_WA_CONTENT_SID=

# --- Alerts outside the screen (support-maintenance and support-sos-ingest send them)
# Web push: generate with  node scripts/generate-vapid-keys.mjs  then  supabase secrets set --env-file <that file>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@ridearrivo.com
# SMS: one of these two. In Nigeria a registered sender ID or a Messaging Service is needed for delivery to reach DND numbers.
SUPPORT_ALERT_SMS_FROM=
SUPPORT_ALERT_MESSAGING_SERVICE_SID=
# WhatsApp alerts: approved sender and an approved template with two variables ({1} headline, {2} detail)
SUPPORT_ALERT_WA_FROM=
SUPPORT_ALERT_WA_CONTENT_SID=
# Phone-call alerts use TWILIO_CALLER_ID above.
