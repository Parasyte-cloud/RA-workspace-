# Copy to /etc/freeradius/3.0/ra-data.secret.conf, chmod 640, owner root:freerad.
# This file stays on the RADIUS server. Never commit the real one.

# Your project's Edge Function URL
ra_data_base_url = "https://fkkxcivxnwshahnbatnp.supabase.co/functions/v1/data-radius"

# mikrotik: also sends Mikrotik-Total-Limit so the gateway itself stops the session when
#           the allowance is spent. generic: standard attributes only (Session-Timeout and
#           Acct-Interim-Interval); the enforcer script then cuts the session.
ra_data_vendor = "mikrotik"

# Same value as: supabase secrets set DATA_RADIUS_SECRET=...
ra_data_secret = "PASTE_THE_SAME_VALUE_AS_DATA_RADIUS_SECRET"
