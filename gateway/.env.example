PARASYTE_BIND_HOST=127.0.0.1
PARASYTE_PORT=8787
PARASYTE_PUBLIC_ORIGIN=https://linux.ridearrivo.com
PARASYTE_ALLOWED_ORIGINS=https://intranet.ridearrivo.com

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

PARASYTE_DOCKER_SOCKET=/run/user/1001/docker.sock
PARASYTE_TOOLING_IMAGE=parasyte-linux-tooling:1.0.0
PARASYTE_CONTAINER_NETWORK_PREFIX=parasyte-engineer
PARASYTE_CONTAINER_MEMORY_MB=2048
PARASYTE_CONTAINER_CPUS=2
PARASYTE_CONTAINER_PIDS=512
PARASYTE_IDLE_STOP_SECONDS=900
PARASYTE_SESSION_MAX_SECONDS=3600
PARASYTE_IDE_SESSION_SECONDS=3600
PARASYTE_AUTH_TIMEOUT_MS=10000
PARASYTE_MAX_MESSAGE_BYTES=65536

# Optional native GitHub dashboard. Configure all three together.
# Store the private key only in this gateway environment, never in Vite or an engineer container.
GITHUB_ORG=Parasyte-cloud
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
