VITE_ALLOWED_EMAIL_DOMAINS=ridearrivo.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Customer/rider identity for membership.ridearrivo.com (Google/Apple
# sign-in) - this is the SAME account as the rider app and ridearrivo.com,
# not a separate identity system. See src/lib/riderAuth.ts for details.
# All of these already have working defaults baked into riderAuth.ts, so
# none of them need to be set for Google sign-in to work today; they exist
# only to override those defaults if the backend URL or client ids change.
#
# Base URL of arrivo-backend on Render. Defaults to the live one.
VITE_ARRIVO_API_BASE_URL=
# Google OAuth web client id, already whitelisted in the backend's
# GOOGLE_OAUTH_CLIENT_IDS. Defaults to the same one ridearrivo-website uses.
VITE_GOOGLE_WEB_CLIENT_ID=
# Apple Services ID from Apple Developer, once one exists for this domain
# (see the setup note in src/lib/riderAuth.ts). Left empty, same as on
# ridearrivo-website today, so the Apple button just stays hidden.
VITE_APPLE_WEB_SERVICES_ID=

VITE_PARASYTE_LINUX_WS=wss://linux.ridearrivo.com/ws

# PArAsYtE Browser V2.1 (see PARASYTE_BROWSER_V2_1_CHANGELOG.md)
# Comma-separated exact origins allowed to render inside the intranet iframe.
# Leave empty until each destination intentionally permits framing by this origin.
VITE_PARASYTE_EMBED_ORIGINS=
# Subset of the above that also gets allow-same-origin in the iframe sandbox.
# Opt-in only, empty by default - see the changelog before setting this.
VITE_PARASYTE_STORAGE_TRUSTED_ORIGINS=
# Optional search engine override for the omnibox (%s = URL-encoded query).
# Falls back to Google automatically if unset or malformed.
VITE_PARASYTE_SEARCH_URL=
