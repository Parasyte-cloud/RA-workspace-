VITE_ALLOWED_EMAIL_DOMAINS=ridearrivo.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Customer/rider identity for membership.ridearrivo.com (Google/Apple sign-in),
# a SEPARATE Supabase project from the one above - that one is the internal
# employee workspace's auth and riders must never be accounts in it. See
# src/lib/riderAuth.ts for details. Create this project, turn on the Google
# and Apple providers in its Auth settings (that needs a Google Cloud OAuth
# client and an Apple Services ID/key, set up directly in Supabase's
# dashboard, not here), then fill these in. Left empty, the Google/Apple
# buttons fall back to a "coming soon" note instead of erroring.
VITE_RIDER_SUPABASE_URL=
VITE_RIDER_SUPABASE_ANON_KEY=

VITE_PARASYTE_LINUX_WS=wss://linux.ridearrivo.com/ws

# PArAsYtE Browser V2.1 (see PARASYTE_BROWSER_V2_1_CHANGELOG.md)
# Comma-separated exact origins allowed to render inside the intranet iframe.
# Leave empty until each destination intentionally permits framing by this origin.
VITE_PARASYTE_EMBED_ORIGINS=
# Subset of the above that also gets allow-same-origin in the iframe sandbox.
# Opt-in only, empty by default - see the changelog before setting this.
VITE_PARASYTE_STORAGE_TRUSTED_ORIGINS=
# Optional search engine override for the omnibox (%s = URL-encoded query).
# Falls back to Google automatically if unset or malformed.
VITE_PARASYTE_SEARCH_URL=
